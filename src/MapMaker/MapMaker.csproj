<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UltraPuck Map Maker</AssemblyName>
    <RootNamespace>UltraPuckMapMaker</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>UltraPuck Map Maker</Product>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same map model and geometry the game uses (plain C#). -->
    <Compile Include="..\CP99Online\Maps\MapData.cs" Link="Shared\MapData.cs" />
    <Compile Include="..\CP99Online\Maps\MapGeometry.cs" Link="Shared\MapGeometry.cs" />
  </ItemGroup>

  <!-- Like the mod: put a fresh build where the installer puts it, if the game is installed here. -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\ClusterPuck 99</GameDir>
  </PropertyGroup>
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(GameDir)\ClusterPuck99.exe')">
    <MakeDir Directories="$(GameDir)\UltraPuck Map Maker" />
    <Copy SourceFiles="$(TargetPath);$(TargetPath).config" DestinationFolder="$(GameDir)\UltraPuck Map Maker" />
  </Target>

</Project>
