<Project Sdk="Microsoft.NET.Sdk">

  <!-- An UltraPuck mod. Build with:  dotnet build -c Release
       The .dll is copied into the game's Mods folder; restart the game and find it in Main menu > Mods. -->

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ExampleMod</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <NoWarn>CS0618</NoWarn>

    <!-- Change this if the game is somewhere else. -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\ClusterPuck 99</GameDir>
    <ManagedDir>$(GameDir)\ClusterPuck99_Data\Managed</ManagedDir>

    <!-- The game runs an old Mono, so compile against the game's own libraries. -->
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(ManagedDir)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(ManagedDir)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(ManagedDir)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <!-- UltraPuck itself (the file keeps its old name so existing installs keep updating). -->
    <Reference Include="UltraPuck"><HintPath>$(GameDir)\BepInEx\plugins\CP99Online\CP99Online.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToModsFolder" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
